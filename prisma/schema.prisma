generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String
}

model Account {
  slug      String   @id
  name      String
  group     String
  bal       Float
  updatedAt DateTime @updatedAt
}

model BudgetCategory {
  slug      String   @id
  name      String
  amt       Float
  spent     Float    @default(0)
  updatedAt DateTime @updatedAt
}

model AppState {
  id            Int      @id @default(1)
  contributed   Float    @default(0)
  basePrincipal Float?
  rothYTDJosh   Float    @default(0)
  rothYTDElana  Float    @default(0)
  currentMonth  String   @default("")
  updatedAt     DateTime @updatedAt
}

model Settings {
  id        Int      @id @default(1)
  efTarget  Float    @default(10000)
  rothLimit Float    @default(7500)
  voo       Int      @default(60)
  qqqm      Int      @default(25)
  stk       Int      @default(15)
  ret       Float    @default(9)
  inflation Float    @default(3)
  age       Int      @default(25)
  retireAge Int      @default(60)
  monthly   Float    @default(3000)
  updatedAt DateTime @updatedAt
}

model NetWorthSnapshot {
  id        Int      @id @default(autoincrement())
  t         BigInt
  nw        Float
  principal Float
  createdAt DateTime @default(now())
}

model AllocationLog {
  id        Int      @id @default(autoincrement())
  t         BigInt
  amt       Float
  steps     Json
  createdAt DateTime @default(now())
}
