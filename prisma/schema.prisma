generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  passwordHash     String?
  image            String?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  authAccounts     AuthAccount[]
  sessions         Session[]
  householdMembers HouseholdMember[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  uploadedFiles    UploadedFile[]
  rules            Rule[]
  categories       Category[]
  categoryGroups   CategoryGroup[]
  budgets          Budget[]
  goals            Goal[]
  debts            Debt[]
}

model AuthAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           HouseholdMember[]
  financialAccounts FinancialAccount[]
  transactions      Transaction[]
  budgets           Budget[]
  goals             Goal[]
  debts             Debt[]
}

model HouseholdMember {
  id           String       @id @default(cuid())
  householdId  String
  userId       String
  role         MemberRole   @default(VIEWER)
  inviteEmail  String?
  inviteStatus InviteStatus @default(PENDING)
  joinedAt     DateTime     @default(now())

  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
}

model FinancialAccount {
  id                  String      @id @default(cuid())
  householdId         String
  name                String
  type                AccountType
  subtype             String?
  institution         String?
  balance             Float       @default(0)
  currency            String      @default("USD")
  isManual            Boolean     @default(true)
  isHidden            Boolean     @default(false)
  excludeFromBudget   Boolean     @default(false)
  excludeFromNetWorth Boolean     @default(false)
  interestRate        Float?
  minimumPayment      Float?
  creditLimit         Float?
  color               String?
  note                String?
  plaidAccountId      String?
  lastSynced          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  household            Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions         Transaction[]
  goals                Goal[]
  holdings             InvestmentHolding[]
  netWorthSnapshots    NetWorthSnapshot[]
}

model Transaction {
  id                 String          @id @default(cuid())
  householdId        String
  accountId          String
  date               DateTime
  merchant           String
  amount             Float
  type               TransactionType
  categoryId         String?
  notes              String?
  tags               String[]
  isReviewed         Boolean         @default(false)
  isRecurring        Boolean         @default(false)
  isReimbursable     Boolean         @default(false)
  isBusiness         Boolean         @default(false)
  isTaxRelated       Boolean         @default(false)
  isIgnored          Boolean         @default(false)
  isTransfer         Boolean         @default(false)
  transferPairId     String?
  recurringId        String?
  plaidTransactionId String?
  receiptUrl         String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  household  Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account    FinancialAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category   Category?            @relation(fields: [categoryId], references: [id])
  recurring  RecurringTransaction? @relation(fields: [recurringId], references: [id])
  splits     TransactionSplit[]
  comments   TransactionComment[]
}

model TransactionSplit {
  id            String    @id @default(cuid())
  transactionId String
  categoryId    String?
  amount        Float
  notes         String?

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category      Category?   @relation(fields: [categoryId], references: [id])
}

model TransactionComment {
  id            String   @id @default(cuid())
  transactionId String
  userId        String
  content       String
  createdAt     DateTime @default(now())

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model CategoryGroup {
  id          String  @id @default(cuid())
  householdId String?
  userId      String?
  name        String
  color       String?
  icon        String?
  sortOrder   Int     @default(0)
  isSystem    Boolean @default(false)

  categories  Category[]
  user        User?    @relation(fields: [userId], references: [id])
}

model Category {
  id          String  @id @default(cuid())
  householdId String?
  userId      String?
  groupId     String?
  name        String
  color       String?
  icon        String?
  emoji       String?
  sortOrder   Int     @default(0)
  isSystem    Boolean @default(false)
  isIncome    Boolean @default(false)

  group            CategoryGroup?   @relation(fields: [groupId], references: [id])
  user             User?            @relation(fields: [userId], references: [id])
  transactions     Transaction[]
  splits           TransactionSplit[]
  budgetCategories BudgetCategory[]
  rules            Rule[]
}

model Rule {
  id          String   @id @default(cuid())
  userId      String
  name        String
  conditions  Json
  categoryId  String?
  setMerchant String?
  setTags     String[]
  setReviewed Boolean?
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
}

model Budget {
  id          String     @id @default(cuid())
  householdId String?
  userId      String
  month       Int
  year        Int
  name        String     @default("Monthly Budget")
  mode        BudgetMode @default(FLEXIBLE)
  income      Float      @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  household  Household?      @relation(fields: [householdId], references: [id])
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]

  @@unique([userId, month, year])
}

model BudgetCategory {
  id         String  @id @default(cuid())
  budgetId   String
  categoryId String
  planned    Float   @default(0)
  rollover   Boolean @default(false)
  rolledOver Float   @default(0)
  isFixed    Boolean @default(false)

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([budgetId, categoryId])
}

model Goal {
  id             String    @id @default(cuid())
  householdId    String?
  userId         String
  accountId      String?
  name           String
  type           GoalType
  targetAmount   Float
  currentAmount  Float     @default(0)
  targetDate     DateTime?
  monthlyContrib Float     @default(0)
  isCompleted    Boolean   @default(false)
  color          String?
  icon           String?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  household Household?        @relation(fields: [householdId], references: [id])
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   FinancialAccount? @relation(fields: [accountId], references: [id])
}

model RecurringTransaction {
  id          String         @id @default(cuid())
  householdId String
  accountId   String
  merchant    String
  amount      Float
  type        TransactionType
  categoryId  String?
  frequency   RecurFrequency
  dayOfMonth  Int?
  nextDueDate DateTime
  lastSeenDate DateTime?
  isActive    Boolean        @default(true)
  isManual    Boolean        @default(false)
  notes       String?
  status      RecurStatus    @default(KEEP)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  transactions Transaction[]
}

model InvestmentHolding {
  id           String     @id @default(cuid())
  accountId    String
  symbol       String
  name         String
  quantity     Float      @default(0)
  costBasis    Float      @default(0)
  currentPrice Float      @default(0)
  assetClass   AssetClass @default(STOCK)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Debt {
  id              String         @id @default(cuid())
  householdId     String?
  userId          String
  name            String
  type            DebtType
  balance         Float
  originalBalance Float?
  interestRate    Float
  minimumPayment  Float
  dueDay          Int?
  payoffStrategy  PayoffStrategy @default(AVALANCHE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  household Household? @relation(fields: [householdId], references: [id])
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotifType
  isRead    Boolean   @default(false)
  link      String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NetWorthSnapshot {
  id        String   @id @default(cuid())
  accountId String
  balance   Float
  date      DateTime @default(now())

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model UploadedFile {
  id           String       @id @default(cuid())
  userId       String
  filename     String
  mimetype     String
  size         Int
  url          String
  status       UploadStatus @default(PENDING)
  rowsImported Int?
  rowsSkipped  Int?
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  changes   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum MemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  LOAN
  MORTGAGE
  INVESTMENT
  RETIREMENT
  CRYPTO
  REAL_ESTATE
  VEHICLE
  CASH
  OTHER_ASSET
  OTHER_LIABILITY
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum BudgetMode {
  FLEXIBLE
  ZERO_BASED
}

enum GoalType {
  SAVINGS
  DEBT_PAYOFF
  INVESTMENT
  EMERGENCY_FUND
  VACATION
  DOWN_PAYMENT
  WEDDING
  OTHER
}

enum RecurFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum RecurStatus {
  KEEP
  CANCEL
  REVIEW
}

enum AssetClass {
  STOCK
  ETF
  BOND
  CRYPTO
  CASH
  REAL_ESTATE
  ALTERNATIVE
  OTHER
}

enum DebtType {
  CREDIT_CARD
  STUDENT_LOAN
  AUTO_LOAN
  MORTGAGE
  PERSONAL_LOAN
  MEDICAL
  OTHER
}

enum PayoffStrategy {
  AVALANCHE
  SNOWBALL
}

enum NotifType {
  OVER_BUDGET
  LARGE_TRANSACTION
  UPCOMING_BILL
  LOW_BALANCE
  GOAL_PROGRESS
  UNUSUAL_SPENDING
  GENERAL
}

enum UploadStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}
